build/
sdkconfig
sdkconfig.old
# managed_components/ and dependencies.lock are deliberately COMMITTED:
# vendoring the exact component sources makes every build (local, CI,
# release) byte-identical and immune to upstream registry changes — the
# DS18B20 driver is safety-critical, so it must not float.
.vscode/
.cursor/
.cache/
.DS_Store

# Secure Boot v2 signing key — must NEVER be committed (see SECURE_BOOT.md).
secure_boot_signing_key.pem
*.pem
sdkconfig.stale-backup-*
