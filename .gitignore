# The sensor drivers are vendored as source under components/ (the
# DS18B20 driver is what the thermostat reads — it must not float).
# dependencies.lock is NOT committed: with no registry dependencies it
# pins nothing, and it embeds machine-specific absolute paths.
dependencies.lock
.vscode/
.cursor/
.cache/
.DS_Store

# Secure Boot v2 signing key — must NEVER be committed (see SECURE_BOOT.md).
secure_boot_signing_key.pem
*.pem
sdkconfig.stale-backup-*
